{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A task item for work tracking and deliverables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 3000 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["pending", "in-progress", "in-review", "completed"] },
        "category": { "type": "string", "maxLength": 150 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "completedAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "status", "category"]
    },
    "ActiveTaskUpdate": {
      "title": "ActiveTaskUpdate",
      "description": "Pinned active tasks entry with date and tasks list persisted until the next update",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 40 },
        "tasks": { "type": "string", "maxLength": 5000 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "completedIndices": {
          "type": "array",
          "description": "Zero-based indices of completed task lines in the active tasks list"
        }
      },
      "required": ["date", "tasks", "updatedAt"]
    },
    "Config": {
      "title": "Config",
      "description": "Shared configuration, active dashboard document, active tasks, and stream backgrounds",
      "type": "object",
      "properties": {
        "sheetUrl": { "type": "string", "maxLength": 500 },
        "dashboardData": { "type": "object" },
        "activeTaskUpdate": { "$ref": "ActiveTaskUpdate" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      }
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks collection shared across devices in real time"
    },
    "/config/{configId}": {
      "schema": "Config",
      "description": "Shared configuration settings, active dashboard state, deliverable vaults, and active tasks log"
    }
  }
}
