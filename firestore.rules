rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string && request.resource.data.title.size() <= 300;
      allow delete: if true;
    }
    
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
